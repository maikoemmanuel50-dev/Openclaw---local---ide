{
  "version": 1,
  "project": "Africa S1 Silicon Savannah",
  "style": "illustrated documentary, soft-but-vivid yellow-base, TED-Ed motion graphics — not photoreal game asset",
  "exports": ["glb", "obj", "fbx", "stl"],
  "meshy_defaults": {
    "model_type": "smart-topology",
    "ai_model": "meshy-t2",
    "should_texture": true,
    "enable_pbr": true,
    "texture_resolution": "2k",
    "target_polycount": 8000,
    "should_remesh": false,
    "image_enhancement": true
  },
  "scenes": [
